# Configuracao do Servidor EasyEmpresa
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (padrao: 3001)
PORT=3001

# Ambiente (development ou production)
NODE_ENV=development

# Caminho do banco de dados SQLite
DB_PATH=./data/database.sqlite

# Chave secreta para JWT (OBRIGATORIO em producao!)
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua-chave-secreta-aqui

# Origins permitidas no CORS (separadas por virgula)
# Em producao, use seu dominio: https://seu-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
